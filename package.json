    "db:test": "node -e \"require('./src/server/database').testConnection()\"",
    "db:query": "node db/query-examples.js"
  },
  "dependencies": {
    "@types/pg": "^8.16.0",
    "concurrently": "^8.2.2",
    "dotenv": "^17.2.4",
    "next": "^14.2.18",
    "pg": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.4",
    "jest": "^29.7.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5"
  }
}

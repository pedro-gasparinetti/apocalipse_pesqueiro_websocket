{
  "name": "apocalipse-pesqueiro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "backend": "node server.js",
    "frontend": "next dev",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "clean": "rmdir /s /q .next 2>nul || echo \"Clean completed\"",
